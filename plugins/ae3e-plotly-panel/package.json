{
  "name": "sorba-plotly-panel",
  "version": "1.0.0",
  "description": "Sorba Plotly panel for Grafana 13 — fork of ae3e-plotly-panel converted to ESM with DataFrame shim for legacy scripts",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --ignore-path ./.gitignore --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "yarn lint --fix"
  },
  "author": "Sorba",
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@grafana/data": "^11.4.0",
    "@grafana/runtime": "^11.4.0",
    "@grafana/ui": "^11.4.0",
    "@swc/core": "^1.3.0",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.0",
    "@types/jest": "^29.5.0",
    "@types/lodash": "^4.14.200",
    "@types/node": "^18.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-webpack-plugin": "^4.0.0",
    "fork-ts-checker-webpack-plugin": "^9.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.0.0",
    "prettier": "^3.0.0",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "^1.69.0",
    "sass-loader": "^13.0.0",
    "style-loader": "^3.3.0",
    "swc-loader": "^0.2.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0",
    "webpack-livereload-plugin": "^3.0.0"
  },
  "dependencies": {
    "@emotion/css": "^11.11.0",
    "@emotion/react": "^11.11.0",
    "deepmerge": "^4.3.1",
    "plotly.js-dist-min": "^2.27.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-plotly.js": "^2.6.0",
    "react-virtualized-auto-sizer": "^1.0.20",
    "tslib": "^2.6.0"
  },
  "peerDependencies": {
    "@grafana/data": "^11.4.0",
    "@grafana/runtime": "^11.4.0",
    "@grafana/ui": "^11.4.0"
  }
}
